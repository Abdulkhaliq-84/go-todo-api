# Copy to .env and adjust. .env is gitignored; this file is committed so anyone
# cloning the repo knows which variables exist.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/todos?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

PORT=8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s
